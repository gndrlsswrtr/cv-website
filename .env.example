# Copy this file to `.env.local` and edit. Never commit real secrets.

# ---------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------
# PostgreSQL connection string. On Railway this is provided automatically as
# `DATABASE_URL` when you add a PostgreSQL service to the project.
#
# The user in this URL must own (or be superuser over) the tables it manages:
# PostgreSQL exempts table owners from Row Level Security, which is how the
# admin path sees every row while the public read path sees only published ones.
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio

# Optional tuning.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true|false   # leave unset to let the driver decide

# Skip running migrations automatically on first query. Use this if you prefer
# to run `npm run db:migrate` as a separate release step.
# AUTO_MIGRATE=false

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap and robots.txt.
# In production set this to your real https:// origin.
SITE_URL=http://localhost:3000

# Site name shown in the browser title and meta tags.
SITE_TITLE=Denrica Samson

# Meta description used for search results and link previews. Only used when the
# "Site description" field in Admin → Settings is empty (Settings always wins,
# and changing it there needs no redeploy). Keep it under 160 characters.
SITE_DESCRIPTION=Denrica Samson — computer engineering student. CV with work experience, education, skills, projects, certifications and a downloadable résumé.

# Port the app listens on (used by `npm start`).
PORT=3000

# Set to "true" to serve the session cookie without the Secure flag.
# Only for plain-HTTP testing (e.g. http://192.168.x.x:3000 on a LAN).
# Never set this in production.
ALLOW_INSECURE=

# ---------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------
# Where uploaded documents are written. On Railway, point this at a mounted
# volume (e.g. /data/uploads) so files survive redeploys.
# Default: ./private/uploads
UPLOAD_DIR=
