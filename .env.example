# Copy this file to `.env.local` and edit. Never commit real secrets.

# Secret used to sign session cookies (AES-GCM). REQUIRED in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the app listens on (used by `npm start`).
PORT=3000

# Where the SQLite database file lives. Relative to the project root.
# Default: ./data/portfolio.db (auto-created on first run)
DATABASE_PATH=

# Where uploaded documents are stored. Relative to the project root.
# Default: ./private/uploads (auto-created on first run)
UPLOAD_DIR=
